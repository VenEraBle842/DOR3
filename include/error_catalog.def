DOR3_ERROR(InvalidVertex, "Invalid vertex ID.", "Use a vertex ID from the current graph.")
DOR3_ERROR(SelfLoop, "Self-loops are not supported.", "Choose two different vertices.")
DOR3_ERROR(DuplicateEdge, "This edge already exists.", "Each undirected edge can appear once.")
DOR3_ERROR(MissingEdge, "This edge does not exist.", "Check the edge ID or both vertex IDs.")
DOR3_ERROR(InvalidParameters, "Invalid parameters.", "Check the specified values.")
DOR3_ERROR(LimitExceeded, "The graph exceeds the application limits.", "Use fewer vertices or edges.")
DOR3_ERROR(InvalidColoring, "The coloring is invalid.", "Recompute the coloring for the current graph.")
DOR3_ERROR(FileRead, "Cannot read graph file.", "Check the path and file format.")
DOR3_ERROR(FileWrite, "Cannot save file.", "Check the path and directory permissions.")
DOR3_ERROR(Unexpected, "Unexpected operation failure.", "Check available memory and try a smaller graph.")
DOR3_ERROR(IdentifierExhausted, "Identifier space is exhausted.", "Create another graph instance.")
